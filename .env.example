# Copy to .env and fill in only what you have. Every key is OPTIONAL:
# the demo runs offline on cached data with no keys at all.

# NewsAPI (newsapi.org) free developer key: enables the optional live NewsAPI adapter.
NEWSAPI_KEY=

# Reddit app credentials (P2, optional live social source).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=riskpulse/0.1

# Override where configs are read from (defaults to ./configs).
# RISKPULSE_CONFIG_DIR=
